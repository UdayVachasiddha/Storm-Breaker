@startuml
left to right direction

actor "Administrator" as Admin
actor "Simulated Attacker" as Attacker
actor "System Process" as System
actor "Alert Service" as Alert

rectangle "DDoS Mitigation System" {
  usecase "Train ML Model" as UC1
  usecase "Start Simulation" as UC2
  usecase "Generate Normal Traffic" as UC3
  usecase "Generate Attack Traffic" as UC4
  usecase "Classify Packet (PASS/DROP)" as UC5
  usecase "Stream Metrics (SSE)" as UC6
  usecase "Filter by Edge Node" as UC7
  usecase "View Confusion Matrix" as UC8
  usecase "Send WhatsApp Alert" as UC9
}

Admin --> UC1
Admin --> UC2
Admin --> UC7
Admin --> UC8

Attacker --> UC4

System --> UC3
System --> UC5
System --> UC6

Alert --> UC9

UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>
UC6 ..> UC5 : <<include>>
UC9 ..> UC6 : <<extend>>

@enduml
